			<Item class="ModuleScript" referent="RBX1D0A9490166841FA8E102F238E6C7257">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Map = require('./@CHL>Map')

export type className = string
export type properties<A> = Map.dictionary<any>

local TableUtils = require('./@CHL>TableUtils')
local Dash = require('./@roblox>Dash')

--// MAIN
local module = {} 

Dash.promise:await()

isClient = game:GetService('RunService'):IsClient()
disguise = require('./LuaUTypes').disguise
forEachArgs = Dash.forEachArgs

function module.create<A>(className: className, props: properties<A>?)
	if not props then
		return function(props2: {[string]: any}?)
			return TableUtils.imprint(Instance.new(className), disguise(props2), true)
		end
	end
	
	return module.create(className)(props)
end

function module.get_or_create<A>(
	parent: Instance, 
	name: string, 
	class: className, 
	properties: properties<A>?)

	local result = parent:FindFirstChild(name)
	local isNewlyCreated = false

	if not result then
		local p = properties or {}
		p.Parent = parent;
		p.Name = name

		result = module.create(class, p)
		isNewlyCreated = true
	end

	return result, isNewlyCreated
end

function module.find_first_descendant<A>(parent: Instance, ...: string): A?
	forEachArgs(function(a)
		if not parent then return end;
		parent = disguise(parent):FindFirstChild(a)
	end, ...)

	return disguise(parent)
end

function module.wait_for_descendant<A>(parent: Instance, ...: string): A
	return module.impatient_wait_for_descendant(1/0, parent, ...)
end

function module.impatient_wait_for_descendant<A>(await_time: number, parent: Instance, ...: string): A
	forEachArgs(function(a)
		if not parent then
			return
		end
		
		parent = parent:WaitForChild(a, await_time)
	end, ...)
	
	return disguise(parent)
end

function module.assert_descendant<A>(parent: Instance, ...: string): A
	forEachArgs(function(a)
		local found = parent:FindFirstChild(a)
		assert(found, `assert failed: found nil, \nname={a}\ncurrent={parent:GetFullName()}`)
		
		parent = found
	end, ...)
	
	return disguise(parent)
end

function module.yield_until_present<A>(parent: A): A
	local p = disguise(parent)

	while not p:IsDescendantOf(game) do p.AncestryChanged:Wait()end

	return parent
end

function module.get_or_clone<T>(parent: Instance, target: T): T
	local result = parent:FindFirstChild(disguise(target).Name)
	
	if not result then
		result = disguise(target):Clone()
		result.Parent = parent
	end
	
	return result
end

--[[
	Returns an instance,
		if runtime is client, parent will wait for child of name,
		otherwise, it will create from getOrCreate
--]]
function module.assume_object_1<T>(parent: Instance, 
	name: string, 
	class: className, 
	properties:  properties<T>?): T
	
	return isClient 
		and disguise(parent):WaitForChild(name, 1/0)
		or module.get_or_create(parent, name, class, properties)
end

function module.get_tagged_ancestor(descendant: Instance, tag: string): Instance?
	descendant = disguise(descendant).Parent
	
	while descendant do
		if descendant:HasTag(tag) then
			return descendant
		end
		descendant = disguise(descendant).Parent
	end
	return
end

--###########################################################################################
--###########################################################################################
--###########################################################################################

Weld = {}

function Weld.apply(part0: BasePart, part1: BasePart, c0: CFrame?, c1: CFrame?)
	local result = Instance.new('Weld')
	result.Part0 = part0
	result.Part1 = part1
	result.C0 = c0 or part0.CFrame:Inverse() * part1.CFrame
	result.C1 = c1 or CFrame.identity
	result.Parent = part0

	return result
end

module.weld = Weld

--###########################################################################################
--###########################################################################################
--###########################################################################################

local Promise = require('./@CHL>Promise')

type promise<T...> = Promise.modified_object<T...>

promise_lib = {}

promise_lib.wait_for_descendant = Promise.promisify(module.wait_for_descendant) :: <A>(parent: Instance, ...string) -> promise<A>
promise_lib.impatient_wait_for_descendant = Promise.promisify(module.impatient_wait_for_descendant) 
	:: <A>(await_time: number, parent: Instance, ...string) -> promise<A>

module.promise = promise_lib

--###########################################################################################
--###########################################################################################
--###########################################################################################

return module
]]></ProtectedString>

			<Properties>
				<ProtectedString name="Source"><![CDATA[local PluginToolset = require('@self/@CHL>PluginToolset')

studio_test_service = game:GetService('StudioTestService')
space_type = PluginToolset.get_space_type()

if space_type == 'client' then
	return
end

local RblxGuiTypes = require('@self/@CHL>RblxGuiLibTypes')
local RblxGuiLibExt = require('@self/@CHL>RblxGuiLibExt')
local InstanceUtils = require('@self/@CHL>InstanceUtils')
local DeadDrop = require('@self/@CHL>PluginDeadDrop')

server_script_service = game:GetService('ServerScriptService')

function studio_space()
	--gui set up
	RblxGuiLibExt.init('__solo_datastore')
	local RblxGuiLib = nil
	
	RblxGuiLib = RblxGuiLibExt.default_lib

	local toolbar = plugin:CreateToolbar("Solo Data Store") :: PluginToolbar
	
	local widget = RblxGuiLib.PluginWidget.new({
		ID = '__solo_datastore_widget_id';
		Enabled = false;
		DockState = Enum.InitialDockState.Float;
		Title = 'Solo DataStore'
	})
	
	widget.WidgetObject.Name = 'Solo DataStore'
	RblxGuiLibExt.widget_init(widget)
	
	local toolbar_button = toolbar:CreateButton("__solo_datastore_button_id", "Open Solo DataStore", "rbxassetid://7743866778", 'Solo DataStore')
	toolbar_button.ClickableWhenViewportHidden = true
	toolbar_button.Click:Connect(function()widget.Content.Enabled=not widget.Content.Enabled;end)

	local system_page, system_frame = RblxGuiLibExt.add_page('System')
	
	RblxGuiLibExt.add_section('System')
	
	RblxGuiLibExt.add_action_button('Install System'):Clicked(function()
		local folder = InstanceUtils.get_or_create(server_script_service, 'SoloDataStore', 'Folder')
		
		InstanceUtils.get_or_create(folder, 'Gateway', 'BindableEvent')
	end)
	
	RblxGuiLibExt.add_action_button('Uninstall System'):Clicked(function()
		local folder = server_script_service:FindFirstChild('SoloDataStore')
		
		if folder then
			folder:Destroy()
		end
	end)
	
	-- thingy
	studio_test_service:GetPropertyChangedSignal('EditModeActive'):Connect(function()
		-- run only out of test session
		if not studio_test_service.EditModeActive then
			return
		end
		
		local data = DeadDrop.retrieve('__solo_datastore')
		
		if data == nil then
			return;
		end
		
		data = DeadDrop.to_medium(data)
		
		local folder = server_script_service:FindFirstChild('SoloDataStore')
		
		if folder then
			folder:SetAttribute('data', data)
		end
		
		plugin:SetSetting('__solo_datastore', nil)
	end)
end

function server_space()
	local bindable = InstanceUtils.promise.impatient_wait_for_descendant(20, server_script_service, 'SoloDataStore', 'Gateway')
	
	bindable:upon(function(bindable_event: BindableEvent)
		bindable_event.Event:Connect(function(state)
			DeadDrop.stash('__solo_datastore', state)
		end)
		bindable_event:SetAttribute('connected', true)
	end):catch(warn)
end

if space_type == 'studio' then
	studio_space()
elseif space_type == 'server' then
	server_space()
end]]></ProtectedString>
